#!/bin/sh
# Stand-in for the agda binary, used as `agda` in the plugin settings by
# the test-suite (see tests/agda_helpers.lua).  The mode is selected via
# AGDA_TEST_MODE:
#
#   replay (default)  answer with the transcript in $AGDA_TRANSCRIPT
#   record, live      run the real Agda ($AGDA_REAL, default `agda`)
#
# In all modes the raw stdin/stdout of the session is logged to
# $AGDA_TEST_DIR/{stdin,stdout}.log; the tests use these logs to detect
# when Agda is idle, and record mode turns them into transcripts.

here=$(cd "$(dirname "$0")" && pwd)

if [ "${AGDA_TEST_MODE:-replay}" = replay ]; then
    if [ "$1" = --version ]; then
        echo "Agda version 2.8.0"
        exit 0
    fi
    exec "${AGDA_TEST_NVIM:-nvim}" --clean --headless -l "$here/../replay.lua" "$@"
fi

if [ "$1" = --version ]; then
    exec "${AGDA_REAL:-agda}" "$@"
fi
tee "$AGDA_TEST_DIR/stdin.log" | "${AGDA_REAL:-agda}" "$@" | tee "$AGDA_TEST_DIR/stdout.log"
